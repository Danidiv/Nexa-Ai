# AZIZ AI local settings
# Edit this file to change your default model/timeouts without typing
# "set AZIZ_MODEL=..." every terminal session.
#
# Real "set" / "export" commands in your terminal always override this file.

# Fast model for iteration/testing (no reasoning overhead, ~2 tok/sec faster path)
AZIZ_MODEL=qwen2.5-3b-instruct

# Slower, higher-quality reasoning model - swap AZIZ_MODEL to this when you
# want a real, polished generation instead of a quick pipeline test:
# AZIZ_MODEL=qwen/qwen3.5-9b

# Bump this up if you switch back to the slow reasoning model (seconds)
AZIZ_READ_TIMEOUT=300
